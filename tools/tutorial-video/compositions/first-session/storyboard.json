  "cues": [
    {
      "start": 0.35,
      "end": 3.31,
      "text": "Welcome to Rawaan."
    },
    {
      "start": 3.31,
      "end": 5.95,
      "text": "Start in Record."
    },
    {
      "start": 5.95,
      "end": 9.949,
      "text": "This is where a conversation becomes a note you can review."
    },
    {
      "start": 9.949,
      "end": 12.829,
      "text": "Choose Record in-person for session audio."
    },
    {
      "start": 12.829,
      "end": 15.469,
      "text": "Already have written notes?"
    },
    {
      "start": 15.469,
      "end": 17.789,
      "text": "Choose Write a summary."
    },
    {
      "start": 17.789,
      "end": 21.149,
      "text": "You do not need to create a client before recording."
    },
    {
      "start": 22.199,
      "end": 26.039,
      "text": "Choose the microphone you want to use, then press Check."
    },
    {
      "start": 26.039,
      "end": 29.159,
      "text": "Allow microphone access if your browser asks."
    },
    {
      "start": 29.159,
      "end": 35.238,
      "text": "You can select an existing client now, or leave the client unassigned and add them after recording."
    },
    {
      "start": 39.199,
      "end": 42.799,
      "text": "Make sure everyone is ready and has agreed to the recording."
    },
    {
      "start": 42.799,
      "end": 46.399,
      "text": "Press Start recording, and focus on the conversation."
    },
    {
      "start": 46.399,
      "end": 49.998,
      "text": "When you are finished, press Stop recording."
    },
    {
      "start": 49.998,
      "end": 53.038,
      "text": "Rawaan transcribes the audio after you stop."
    },
    {
      "start": 53.038,
      "end": 56.318,
      "text": "Keep the page open while it works."
    },
    {
      "start": 56.318,
      "end": 60.878,
      "text": "The recording shown here uses a fictional training conversation."
    },
    {
      "start": 65.199,
      "end": 69.599,
      "text": "If you did not select a client earlier, Assign Session opens next."
    },
    {
      "start": 69.599,
      "end": 73.999,
      "text": "Choose an existing client, or press Create New and complete their details."
    },
    {
      "start": 73.999,
      "end": 76.878,
      "text": "Select the client and press Next."
    },
    {
      "start": 76.878,
      "end": 80.718,
      "text": "Rawaan now creates a draft from the transcript."
    },
    {
      "start": 80.718,
      "end": 84.558,
      "text": "Creating a client alone does not approve the note."
    },
    {
      "start": 86.199,
      "end": 89.719,
      "text": "Check the draft against the original conversation."
    },
    {
      "start": 89.719,
      "end": 94.999,
      "text": "Open Transcript to review the words captured, especially names and clinical terms."
    },
    {
      "start": 94.999,
      "end": 99.718,
      "text": "Return to Notes and choose Edit note to correct anything that needs changing."
    },
    {
      "start": 99.718,
      "end": 105.478,
      "text": "The draft is yours to review; approval should wait until it accurately reflects the session."
    },
    {
      "start": 110.199,
      "end": 113.719,
      "text": "When you are satisfied, choose Approve and Save Note."
    },
    {
      "start": 113.719,
      "end": 116.919,
      "text": "The approved note becomes part of that client's record."
    },
    {
      "start": 116.919,
      "end": 122.598,
      "text": "To return to it, open Clients, choose the client, and open Sessions."
    },
    {
      "start": 122.598,
      "end": 124.998,
      "text": "Approved notes are read-only."
    },
    {
      "start": 124.998,
      "end": 131.158,
      "text": "That is the complete flow: record, assign, review, and save."
    }
  ],
  "voice": "hannah",
  "model": "canopylabs/orpheus-v1-english",
  "narrated": true
}