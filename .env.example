# Server-side Groq API key used by Scribe transcription, note drafting, and translation.
# Required Clerk application keys. Secret key is server-only.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_from_clerk
# CLERK_SECRET_KEY=sk_test_or_sk_live_from_clerk
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/record
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/record

# GROQ_API_KEY=your_groq_api_key_here

# Optional Scribe note-generation/translation model override.
# Default: qwen/qwen3.8-27b (verified on this account to return clean JSON;
# the gpt-oss models emit reasoning tokens that can truncate JSON output).
# LLM_MODEL=qwen/qwen3.8-27b

# Required Supabase storage for patients, approved notes, and chats.
# Apply supabase/schema.sql first; missing credentials or database errors fail clearly.
# These server-only names are preferred and read at runtime:
# SUPABASE_URL=your_project_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Or use the newer Supabase secret key instead (takes precedence):
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# Keys stay server-only; never give either a NEXT_PUBLIC_ prefix.
# Anon/public keys are not used for server storage or migration: RLS can hide rows.
# The existing NEXT_PUBLIC URL remains supported for compatibility:
# NEXT_PUBLIC_SUPABASE_URL=your_project_url

# Optional server-only internet search for Rawaan AI. Free Tavily account provides monthly credits.
# TAVILY_API_KEY=your_tavily_api_key
