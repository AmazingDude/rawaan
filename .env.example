# Server-side Groq API key used by Scribe transcription and future Brain answer generation.
# GROQ_API_KEY=your_groq_api_key_here

# Optional Brain/note-generation model override.
# Default: qwen/qwen3.8-27b (verified on this account to return clean JSON;
# the gpt-oss models emit reasoning tokens that can truncate JSON output).
# LLM_MODEL=qwen/qwen3.8-27b

# Supabase project URL and anon key for patients/notes storage.
# When unset, the app falls back to local JSON files under data/.
# NEXT_PUBLIC_SUPABASE_URL=your_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
