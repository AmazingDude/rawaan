# Server-side Groq API key used by Scribe transcription and future Brain answer generation.
# GROQ_API_KEY=your_groq_api_key_here

# Optional Brain-model override. Default: openai/gpt-oss-120b.
# Set to llama-3.3-70b-versatile only after an explicit JSON-compliance review.
# LLM_MODEL=openai/gpt-oss-120b
